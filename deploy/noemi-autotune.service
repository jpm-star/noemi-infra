[Unit]
Description=Noemi — agente de self-análise (proslog+radar → tuning de conversão)
After=network.target
[Service]
Type=oneshot
WorkingDirectory=/root/noemi-infra
EnvironmentFile=-/root/noemi-infra/.env
EnvironmentFile=-/root/noemi-infra/infra/.env
ExecStart=/root/noemi-infra/.venv/bin/python apps/painel-operacoes/autotune.py
