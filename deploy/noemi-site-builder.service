[Unit]
Description=Site Studio — ferramenta de produção do JP (auth, via Caddy go.noemi.digital/studio)
After=network.target

[Service]
WorkingDirectory=/root/noemi-infra
EnvironmentFile=-/root/noemi-infra/.env
# App em 127.0.0.1; o Caddy é a borda pública TLS (handle /studio/* → :8020) e a
# auth (auth.py) protege as rotas. Seed da senha: BUILDER_PASSWORD=... auth.py set-password
ExecStart=/root/noemi-infra/.venv/bin/uvicorn builder_web:app --app-dir apps/motor-isca-sites --host 127.0.0.1 --port 8020
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
