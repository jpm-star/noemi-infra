[Unit]
Description=Relatorio semanal do Radar + alerta de padrao 3x
[Service]
Type=oneshot
WorkingDirectory=/root/noemi-infra/apps/painel-operacoes
EnvironmentFile=-/root/noemi-infra/infra/.env
Environment=PYTHONPATH=/root/noemi-infra/packages
ExecStart=/root/noemi-infra/.venv/bin/python radar_ops.py --relatorio
