[Unit]
Description=Motor B — Vídeo IA (noemi-infra, video.noemi.digital)
After=network.target

[Service]
WorkingDirectory=/root/noemi-infra
EnvironmentFile=-/root/noemi-infra/.env
ExecStart=/root/noemi-infra/.venv/bin/uvicorn main:app --app-dir apps/motor-b-video --host 127.0.0.1 --port 8010
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
